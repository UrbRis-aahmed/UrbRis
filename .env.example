# Urbris environment variables
# Set these in Render (Dashboard -> urbris service -> Environment).
# For local runs: copy to .env, fill in, then `set -a; source .env; set +a; python3 urbris.py`
# Never commit a filled-in .env.

# --- Core (route analysis, maps) ---
ANTHROPIC_API_KEY=          # Claude vision for iRAP coding + batch poller
GOOGLE_MAPS_PUBLIC_KEY=     # Served to the browser; restrict by HTTP referrer to urbris.com

# --- Saved routes (Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Research scan email (Resend) ---
RESEND_API_KEY=
RESEARCH_EMAIL_TO=
RESEND_FROM=onboarding@resend.dev

# --- Alerts (Twilio, optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# --- Set automatically by Render; leave unset locally (defaults to localhost:8000) ---
# PORT=
